# The Dry Clean - Backend Environment Variables
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# CORS
CORS_ORIGINS=*

# MongoDB Replica Set URI
MONGODB_URI=mongodb://localhost:27017/the_dry_clean?replicaSet=rs0

# JWT Auth Secrets
JWT_SECRET=atelier_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Sentry DSN
SENTRY_DSN=

# Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=s3
AWS_S3_BUCKET=atelier-proofs-private
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=atelier_mock_access_key
AWS_SECRET_ACCESS_KEY=atelier_mock_secret_access_key
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_EXPIRY=900
STORAGE_MAX_FILE_SIZE=5242880


